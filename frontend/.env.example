# Backend API URL
VITE_BACKEND_URL=http://localhost:3001

# AAP OAuth Configuration
# Client ID can be in frontend (it's public, not a secret)
VITE_AAP_CLIENT_ID=eda-playground-client

# OAuth Redirect URI (defaults to current origin + /auth/callback if not set)
VITE_AAP_REDIRECT_URI=http://localhost:5173/auth/callback

# AAP Instance URL (optional - pre-fills the login form in deployments)
# Leave empty for local development, set for OCP/MicroShift deployments
VITE_AAP_BASE_URL=
