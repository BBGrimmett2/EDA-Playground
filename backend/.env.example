# Backend Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL for CORS (development only)
FRONTEND_URL=http://localhost:5173

# Allow self-signed certificates (useful for testing with self-signed AAP)
ALLOW_SELF_SIGNED_CERTS=true

# AAP OAuth Configuration
# Create an OAuth2 Application in AAP and copy the credentials here
AAP_CLIENT_ID=eda-playground-client
AAP_CLIENT_SECRET=your-secret-here
AAP_REDIRECT_URI=http://localhost:5173/auth/callback

# AAP Instance URL (optional - pre-fills the login form)
# Leave empty for local dev where users type their AAP URL
# Set for OCP/MicroShift deployments to auto-fill the login form
AAP_BASE_URL=

# Cookie Configuration
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
SESSION_SECRET=random-secret-for-signing-cookies-change-in-production
