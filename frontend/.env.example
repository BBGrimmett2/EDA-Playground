# Backend API URL
VITE_BACKEND_URL=http://localhost:3001

# AAP Instance URL (optional - pre-fills the login form in deployments)
# Leave empty for local development, set for OCP/MicroShift deployments
VITE_AAP_BASE_URL=

# Note: OAuth configuration (AAP_CLIENT_ID, AAP_REDIRECT_URI) is now
# fetched from the backend at runtime via /api/aap/auth/config endpoint.
# This allows the same frontend build to work across environments without rebuild.
