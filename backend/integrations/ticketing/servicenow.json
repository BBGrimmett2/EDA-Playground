      "event_type": {"enum": ["incident.created", "incident.updated", "incident.resolved", "incident.closed"]},
      "incident": {
        "type": "object",
        "required": ["sys_id", "number", "short_description"]
      }
    }
  },
  "documentation": "https://docs.servicenow.com/bundle/tokyo-application-development/page/integrate/outbound-rest/concept/c_OutboundREST.html",
  "tags": ["servicenow", "itsm", "incident", "ticketing", "snow"]
}
